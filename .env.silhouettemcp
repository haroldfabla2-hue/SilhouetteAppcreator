# Configuración de Personalización - SilhouetteMCP Server
# Copia este archivo como .env en /opt/silhouettemcp/ y modifica según necesites

# INFORMACIÓN DEL DOMINIO
DOMAIN=silhouettemcp.albertofarah.com
EMAIL=alberto.farahb@hotmail.com

# CONFIGURACIÓN DEL SERVIDOR
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CONFIGURACIÓN DE SEGURIDAD
ADMIN_EMAIL=alberto.farahb@hotmail.com
SESSION_SECRET=tu_clave_secreta_aqui_cambiar_en_produccion
ALLOWED_HOSTS=silhouettemcp.albertofarah.com,localhost

# CONFIGURACIÓN DE LOGS
LOG_LEVEL=INFO
LOG_FILE=/opt/silhouettemcp/logs/silhouettemcp.log

# CONFIGURACIÓN DE BACKUP
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 2 * * *  # Cron: diario a las 2:00 AM

# CONFIGURACIÓN DE HEALTH CHECK
HEALTH_CHECK_INTERVAL=300  # 5 minutos
HEALTH_CHECK_TIMEOUT=30

# CONFIGURACIÓN DE RATE LIMITING
API_RATE_LIMIT=100  # requests per minute
ADMIN_RATE_LIMIT=10  # requests per minute

# CONFIGURACIÓN DE SSL
SSL_RENEWAL_SCHEDULE=0 2 * * *  # Cron: diario a las 2:00 AM
SSL_EMAIL=alberto.farahb@hotmail.com

# CONFIGURACIÓN DE MONITORING
ENABLE_METRICS=true
ENABLE_WEBSOCKET=true
METRICS_UPDATE_INTERVAL=2  # segundos

# CONFIGURACIÓN DE PERSISTENCIA
DATA_FILE=/opt/silhouettemcp/silhouettemcp_data.json
BACKUP_FILE=/opt/silhouettemcp/backup.json

# CONFIGURACIÓN DE CORS
CORS_ORIGINS=https://silhouettemcp.albertofarah.com,http://localhost:3000,http://127.0.0.1:3000

# CONFIGURACIÓN DE DESARROLLO (cambiar a false en producción)
DEBUG=false
RELOAD=false

# CONFIGURACIÓN DE DOCKER
COMPOSE_PROJECT_NAME=silhouettemcp
COMPOSE_FILE=docker-compose.silhouettemcp.yml