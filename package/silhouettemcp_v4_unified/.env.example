# =========================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# SilhouetteMCP Server - FINAL UNIFIED v4.0.0
# =========================================================

# === CONFIGURACIÓN BÁSICA ===
PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# === AUTENTICACIÓN ===
ADMIN_EMAIL=alberto.farahb@hotmail.com
ADMIN_PASSWORD_HASH= # Hash SHA256 de la contraseña
# Generar con: echo -n "tu_contraseña" | sha256sum

# === SUPABASE CONFIGURATION ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PROJECT_ID=your-project-id

# === BASE DE DATOS (OPCIONAL) ===
# Para uso con PostgreSQL local en lugar de Supabase
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=silhouettemcp
POSTGRES_USER=silhouettemcp
POSTGRES_PASSWORD=securepassword

# === REDIS CACHE (OPCIONAL) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === SSL/HTTPS CONFIGURATION ===
SSL_CERT_PATH=/path/to/your/ssl/certificate.crt
SSL_KEY_PATH=/path/to/your/ssl/private.key

# === API KEYS EXTERNAS ===
# Google Maps API Key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenAI API Key (para herramientas de IA)
OPENAI_API_KEY=your-openai-api-key

# Claude API Key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Exchange Rate API
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# News API
NEWS_API_KEY=your-news-api-key

# === CONFIGURACIÓN DE RENDIMIENTO ===
MAX_WORKERS=4
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=300
CACHE_TTL=3600

# === CONFIGURACIÓN DE LOGGING ===
LOG_FORMAT=json
LOG_FILE=/var/log/silhouettemcp/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# === MONITORING ===
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
SENTRY_DSN=your-sentry-dsn

# === SEGURIDAD ===
ALLOWED_HOSTS=silhouettemcp.albertofarah.com,localhost,127.0.0.1
CORS_ORIGINS=*
CSRF_TRUSTED_ORIGINS=https://silhouettemcp.albertofarah.com
SECURE_COOKIES=true

# === CONFIGURACIÓN DE EMAIL (OPCIONAL) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# === CONFIGURACIÓN DE ALMACENAMIENTO ===
UPLOAD_FOLDER=/tmp/uploads
MAX_FILE_SIZE=50MB
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,doc,docx,xls,xlsx

# === CONFIGURACIÓN ESPECÍFICA DE AGENTES ===

# Maps Agent
DEFAULT_MAP_LOCATION=Madrid, España
DEFAULT_MAP_RADIUS=10000

# Financial Agent
DEFAULT_CURRENCY=EUR
DEFAULT_TIMEZONE=Europe/Madrid
FINANCIAL_DATA_CACHE_TTL=300

# Social Media Agent
DEFAULT_SOCIAL_PLATFORM=twitter
SOCIAL_MEDIA_CACHE_TTL=1800

# Content Agent
DEFAULT_LANGUAGE=es
CONTENT_GENERATION_TIMEOUT=60
MAX_CONTENT_LENGTH=10000

# Database Agent
DB_CONNECTION_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30
DB_QUERY_TIMEOUT=60

# Research Agent
DEFAULT_SEARCH_RESULTS=10
RESEARCH_CACHE_TTL=7200
MAX_SEARCH_QUERY_LENGTH=500

# === CONFIGURACIÓN DE BACKUP ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/var/backups/silhouettemcp

# === CONFIGURACIÓN DE DESARROLLO ===
AUTO_RELOAD=false
DEVELOPMENT_MODE=false
TEST_DATABASE_URL=sqlite:///./test.db

# === CONFIGURACIÓN DE CONTENEDORES ===
COMPOSE_PROJECT_NAME=silhouettemcp_v4_unified
COMPOSE_FILE=docker-compose.yml

# === CONFIGURACIÓN DE GRAFANA (OPCIONAL) ===
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# === CONFIGURACIÓN DE PROMETHEUS (OPCIONAL) ===
PROMETHEUS_PORT=9090

# === CONFIGURACIÓN DE NGINX (OPCIONAL) ===
NGINX_HOST=80
NGINX_SSL_HOST=443
NGINX_CLIENT_MAX_BODY_SIZE=50M

# =========================================================
# INSTRUCCIONES DE USO:
# 1. Copia este archivo como .env en el directorio del servidor
# 2. Modifica las variables según tu configuración
# 3. NO subas el archivo .env a repositorios públicos
# =========================================================
