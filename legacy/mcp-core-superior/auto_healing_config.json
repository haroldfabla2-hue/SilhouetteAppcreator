      "custom_thresholds": {
        "cpu_warning": 65.0,
        "cpu_critical": 80.0,
        "memory_warning": 70.0,
        "memory_critical": 85.0,
        "response_time_warning": 1.5,
        "response_time_critical": 3.0,
