  "global_circuit_breaker": {
    "failure_threshold": 5,
    "recovery_timeout": 60,
    "expected_exception": "Exception",
    "fallback_function": null
  },
  "log_level": "INFO",
  "log_metrics": true,
  "log_recovery_actions": true,
  "log_scaling_events": true,
  "enable_webhook_notifications": false,
  "webhook_url": null,
  "enable_email_alerts": false,
  "email_recipients": [],
  "ml_enabled": true,
  "ml_model_update_interval": 3600,
  "ml_confidence_threshold": 0.8,
  "ml_training_data_retention_days": 7,
  "graceful_degradation_enabled": true,
  "degradation_strategies": [
    "reduce_concurrency",
    "increase_timeouts",
    "disable_non_essential_features",
    "fallback_to_cache"
  ],
  "enable_automatic_backup": true,
  "backup_interval": 3600,
  "backup_retention_days": 30,
  "restore_on_critical_failure": true,
  "notification_channels": {
    "console": true,
    "file": false,
    "webhook": false,
    "email": false,
    "slack": false
  }
}