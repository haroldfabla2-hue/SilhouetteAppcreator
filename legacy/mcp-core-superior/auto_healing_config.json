    "scaling_trigger_response_time": 2.0,
    "auto_recovery_failure_threshold": 3,
    "auto_recovery_cooldown": 300,
    "max_recovery_attempts": 5
  },
  "auto_scaling_config": {
    "min_instances": 1,
    "max_instances": 10,
    "target_cpu_usage": 70.0,
    "target_memory_usage": 80.0,
    "scaling_cooldown": 300,
    "metrics_window": 60
