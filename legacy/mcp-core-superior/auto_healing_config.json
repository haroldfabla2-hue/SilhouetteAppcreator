{
  "enabled": true,
  "debug_mode": false,
  "environment": "production",
  "monitoring_interval": 10,
  "metrics_retention_hours": 24,
  "alert_cooldown": 300,
  "global_thresholds": {
    "cpu_warning": 70.0,
    "cpu_critical": 85.0,
    "memory_warning": 75.0,
    "memory_critical": 90.0,
    "response_time_warning": 1.0,
    "response_time_critical": 2.5,
    "error_rate_warning": 0.05,
    "error_rate_critical": 0.10,
    "agent_health_score_warning": 0.7,
    "agent_health_score_critical": 0.5,
    "agent_failure_prediction_warning": 0.6,
    "agent_failure_prediction_critical": 0.8,
    "scaling_trigger_cpu": 80.0,
