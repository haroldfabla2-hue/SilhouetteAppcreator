{"name": "file-processing-agent", "displayName": "File Processing Agent", "description": "Agente MCP para procesamiento avanzado de archivos multimedia y documentos", "version": "1.0.0", "type": "stdio", "command": "python3", "args": ["file_processing_server.py"], "env": {}, "capabilities": {"tools": {"listChanged": false}, "resources": {"subscribe": false, "listChanged": false}, "prompts": {"listChanged": false}, "logging": {}}, "file_extensions": {"documents": [".pdf", ".docx", ".xlsx", ".pptx", ".txt", ".md", ".csv", ".json", ".html", ".rtf"], "images": [".jpg", ".jpeg", ".png", ".tiff", ".tif", ".gif", ".bmp", ".webp", ".svg"], "audio": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a"], "video": [".mp4", ".avi", ".mov", ".mkv", ".webm", ".flv"]}, "tools_config": {"extract_text_from_document": {"description": "Extrae texto de documentos (PDF, DOCX, TXT, MD, HTML, CSV, JSON)", "supported_formats": [".pdf", ".docx", ".xlsx", ".pptx", ".txt", ".md", ".csv", ".json", ".html", ".rtf"], "max_file_size": "50MB"}, "analyze_image_with_ai": {"description": "Analiza imagen con IA: describe contenido, detecta objetos, OCR, QR codes", "supported_formats": [".jpg", ".jpeg", ".png", ".tiff", ".tif", ".gif", ".bmp", ".webp", ".svg"], "analysis_types": ["basic", "detailed", "ocr", "qr_detection", "objects", "full"], "ocr_languages": ["spa", "eng"]}, "convert_file_format": {"description": "Convierte archivos entre formatos compatibles", "supported_conversions": {"image": [".jpg", ".jpeg", ".png", ".tiff", ".bmp"], "document": [".pdf", ".docx", ".txt"], "audio": [".mp3", ".wav", ".flac", ".aac"], "video": [".mp4", ".avi", ".mov"]}}, "extract_metadata": {"description": "Extrae metadata completa de cualquier archivo soportado", "metadata_types": ["system", "media", "document", "content_analysis"]}, "process_audio_file": {"description": "Analiza archivos de audio: extrae metadata, transcribe (si tiene voz)", "supported_formats": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a"], "analysis_types": ["metadata", "waveform", "features", "full"]}, "process_video_file": {"description": "Analiza archivos de video: extrae metadata, frames, información técnica", "supported_formats": [".mp4", ".avi", ".mov", ".mkv", ".webm", ".flv"], "frame_extraction": {"enabled": true, "max_frames": 20}}, "batch_process_files": {"description": "Procesa múltiples archivos en lote", "max_files_per_batch": 50, "supported_operations": ["extract_text", "analyze_image", "extract_metadata", "auto"]}}, "requirements": {"python_packages": ["pillow", "opencv-python", "pytesseract", "python-docx", "openpyxl", "python-pptx", "librosa", "mutagen", "ffmpeg-python", "qrcode", "pyzbar"], "system_dependencies": ["tesseract-ocr", "ffmpeg"], "optional_packages": ["chardet", "PyPDF2"]}, "examples": [{"tool": "extract_text_from_document", "description": "Extraer texto de un PDF", "input_file_path": "/path/to/document.pdf", "operation": "pdf"}, {"tool": "analyze_image_with_ai", "description": "Analizar imagen con OCR", "file_path": "/path/to/image.png", "analysis_type": "full", "ocr_languages": ["spa", "eng"]}, {"tool": "convert_file_format", "description": "Convertir imagen a JPG", "input_file_path": "/path/to/image.png", "output_format": "jpg", "output_file_path": "/path/to/image.jpg", "quality": 85}, {"tool": "extract_metadata", "description": "Extraer metadata de archivo de audio", "file_path": "/path/to/audio.mp3", "include_content_analysis": true}, {"tool": "batch_process_files", "description": "Procesar múltiples archivos", "file_paths": ["/path/to/file1.pdf", "/path/to/file2.jpg"], "operation": "auto"}], "limitations": {"max_file_size": "50MB", "max_batch_size": 50, "supported_encodings": ["utf-8", "latin-1", "cp1252"], "ocr_languages": ["spa", "eng"]}, "logging": {"level": "INFO", "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"}}