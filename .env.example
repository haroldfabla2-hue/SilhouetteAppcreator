# =============================================================================
# SilhouetteAppcreator — plantilla de configuración
#
# Copie este archivo a `.env` y rellene los valores. `.env` está en .gitignore:
# NUNCA lo versione. Si alguna vez subió una clave, revóquela y genere otra;
# borrarla del árbol no la retira del historial de Git.
# =============================================================================

# --- Autenticación de administrador (obligatorio) ----------------------------
# Sin estas dos variables, los endpoints protegidos responden 503 (falla en
# cerrado). Genere el hash con:
#
#     python -m backend.app.security.auth "su-contraseña"
#
SILHOUETTE_ADMIN_EMAIL=
SILHOUETTE_ADMIN_PASSWORD_HASH=

# --- Red ---------------------------------------------------------------------
# Orígenes permitidos por CORS, separados por comas. No use "*": junto a
# allow_credentials=True es inválido y expone la API a cualquier sitio web.
SILHOUETTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Límites de capacidad ----------------------------------------------------
# Raíz a la que se confinan las lecturas y escrituras de archivos vía API.
# Por defecto, la raíz del repositorio.
SILHOUETTE_WORKSPACE_ROOT=

# Aplicaciones que /api/system/os-launch puede lanzar, separadas por comas.
# Vacío = capacidad desactivada. Sólo nombres; la ruta se resuelve por PATH.
SILHOUETTE_ALLOWED_APPS=

# --- Proveedores de modelos --------------------------------------------------
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=

# --- Memoria cognitiva (silhouette-brain) ------------------------------------
# Sin configurar, la memoria funciona con SQLite y un embedder sin dependencias.
# Estas variables activan los backends de producción.
SILHOUETTE_DATA_DIR=
SILHOUETTE_REDIS_URL=
SILHOUETTE_NEO4J_URI=
SILHOUETTE_NEO4J_USER=
SILHOUETTE_NEO4J_PASSWORD=

# --- Persistencia ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agente_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
