# MCP Core Superior - Configuración de Desarrollo

# === CONFIGURACIÓN BÁSICA ===
MCP_CORE_ENVIRONMENT=development
MCP_CORE_DEBUG=true
MCP_CORE_APP_NAME=MCP Core Superior
MCP_CORE_APP_VERSION=1.0.0

# === PUERTOS Y HOSTS ===
MCP_CORE_HOST=0.0.0.0
MCP_CORE_PORT=8080
MCP_CORE_MCP_PORT=8081

# === CONTEXTFORGE GATEWAY ===
CONTEXTFORGE_URL=http://localhost:8001
MCP_CORE_CONTEXTFORGE_TIMEOUT=30

# === BASE DE DATOS ===
DATABASE_URL=sqlite:///./mcp_core_dev.db

# === VECTOR STORE ===
VECTOR_DB_URL=sqlite:///./vector_db_dev.db

# === REDIS CACHE ===
REDIS_URL=redis://localhost:6379

# === AUTENTICACIÓN ===
MCP_CORE_jwt_secret=mcp_core_dev_secret_2024_secure_key_for_development_only

# === PERFORMANCE ===
MCP_CORE_MAX_CONCURRENT_TASKS=10
MCP_CORE_MAX_CONCURRENT_TOOLS=5
MCP_CORE_DEFAULT_TIMEOUT_SECONDS=300

# === STREAMING ===
MCP_CORE_STREAMING_ENABLED=true
MCP_CORE_STREAMING_FREQUENCY=1.0
MCP_CORE_STREAMING_MAX_DURATION=3600

# === RATE LIMITING ===
MCP_CORE_RATE_LIMIT_ENABLED=false
MCP_CORE_RATE_LIMIT_REQUESTS=100
MCP_CORE_RATE_LIMIT_WINDOW=60

# === LOGGING ===
MCP_CORE_LOG_LEVEL=INFO

# === MONITOREO ===
MCP_CORE_METRICS_ENABLED=true
MCP_CORE_METRICS_PORT=9090

# === AGENTES ===
MCP_CORE_AGENT_TIMEOUT_SECONDS=60
MCP_CORE_AGENT_RETRY_ATTEMPTS=3
MCP_CORE_AGENT_RETRY_DELAY=1.0

# === EXECUTOR ===
MCP_CORE_EXECUTOR_MAX_WORKERS=4
MCP_CORE_EXECUTOR_MEMORY_LIMIT_MB=512

# === MEMORY MANAGER ===
MCP_CORE_MEMORY_CACHE_SIZE=1000

# === VERIFIER ===
MCP_CORE_VERIFICATION_QUALITY_THRESHOLD=0.8

# === HEALTH CHECKS ===
MCP_CORE_HEALTH_CHECK_INTERVAL=30

# === CORS ===
MCP_CORE_CORS_ENABLED=true
