# MCP Core Superior - Configuración de Desarrollo
# Este archivo contiene configuraciones específicas para el entorno de desarrollo

# === CONFIGURACIÓN BÁSICA ===
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
APP_NAME=MCP Core Superior Dev
APP_VERSION=1.0.0-dev

# === PUERTOS ===
HOST=0.0.0.0
PORT=8080
MCP_PORT=8081
METRICS_PORT=9090

# === CONTEXTFORGE ===
CONTEXTFORGE_URL=http://localhost:8001
CONTEXTFORGE_TIMEOUT=30
CONTEXTFORGE_API_KEY=

# === BASE DE DATOS ===
DATABASE_URL=postgresql://mcpuser:devpassword123@localhost:5432/mcp_core
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# === VECTOR DATABASE ===
VECTOR_DB_URL=postgresql://mcpuser:devpassword123@localhost:5433/vector_db
VECTOR_DB_POOL_SIZE=3
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# === REDIS ===
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=5
REDIS_TIMEOUT=30

# === AUTENTICACIÓN ===
JWT_SECRET=dev-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === PERFORMANCE ===
MAX_CONCURRENT_TASKS=20
MAX_CONCURRENT_TOOLS=10
DEFAULT_TIMEOUT_SECONDS=300
STREAMING_BUFFER_SIZE=1000

# === STREAMING ===
STREAMING_ENABLED=true
STREAMING_FREQUENCY=0.5
STREAMING_MAX_DURATION=3600

# === RATE LIMITING (DESHABILITADO EN DESARROLLO) ===
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# === LOGGING ===
LOG_FORMAT=json
LOG_FILE=logs/mcp-core-dev.log
LOG_MAX_SIZE=50
LOG_BACKUP_COUNT=3

# === MONITOREO ===
METRICS_ENABLED=true
TRACING_ENABLED=false

# === AGENTES ===
AGENT_TIMEOUT_SECONDS=60
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_DELAY=1.0

# === EXECUTOR ===
EXECUTOR_MAX_WORKERS=2
EXECUTOR_MEMORY_LIMIT_MB=256
EXECUTOR_CPU_LIMIT=0.5

# === MEMORY MANAGER ===
MEMORY_CACHE_SIZE=500
MEMORY_CLEANUP_INTERVAL=1800
MEMORY_MAX_AGE_HOURS=12

# === VERIFIER ===
VERIFICATION_QUALITY_THRESHOLD=0.7
VERIFICATION_STRICT_MODE=false

# === HEALTH CHECKS ===
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# === CORS ===
CORS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:8001"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_HEADERS=["*"]

# === CONFIGURACIONES ESPECÍFICAS DE DESARROLLO ===
AUTO_HEALING_ENABLED=false
INTELLIGENT_ROUTER_ENABLED=true
PARALLEL_EXECUTION_ENABLED=true
COLLABORATION_ENGINE_ENABLED=true
CONTEXT_PERSISTENCE_ENABLED=true
FILE_PROCESSING_ENABLED=true
WEB_SCRAPING_ENABLED=true
GIT_OPERATIONS_ENABLED=true
DATABASE_OPERATIONS_ENABLED=true

# === MODO DESARROLLO ESPECÍFICO ===
SKIP_MIGRATIONS=false
HOT_RELOAD=true
EXPOSE_ALL_ENDPOINTS=true
ENABLE_DEBUG_ENDPOINTS=true