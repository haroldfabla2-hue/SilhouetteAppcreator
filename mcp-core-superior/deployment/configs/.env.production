# MCP Core Superior - Configuración de Producción
# Este archivo contiene configuraciones específicas para el entorno de producción

# === CONFIGURACIÓN BÁSICA ===
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING
APP_NAME=MCP Core Superior
APP_VERSION=1.0.0

# === PUERTOS ===
HOST=0.0.0.0
PORT=8080
MCP_PORT=8081
METRICS_PORT=9090

# === CONTEXTFORGE ===
CONTEXTFORGE_URL=http://contextforge:8001
CONTEXTFORGE_TIMEOUT=30
CONTEXTFORGE_API_KEY=${CONTEXTFORGE_API_KEY}

# === BASE DE DATOS ===
DATABASE_URL=postgresql://mcpuser:${POSTGRES_PASSWORD}@postgres:5432/mcp_core
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30

# === VECTOR DATABASE ===
VECTOR_DB_URL=postgresql://mcpuser:${VECTOR_POSTGRES_PASSWORD}@vector_postgres:5432/vector_db
VECTOR_DB_POOL_SIZE=10
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# === REDIS ===
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_POOL_SIZE=20
REDIS_TIMEOUT=30

# === AUTENTICACIÓN ===
JWT_SECRET=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === PERFORMANCE ===
MAX_CONCURRENT_TASKS=50
MAX_CONCURRENT_TOOLS=10
DEFAULT_TIMEOUT_SECONDS=300
STREAMING_BUFFER_SIZE=2000

# === STREAMING ===
STREAMING_ENABLED=true
STREAMING_FREQUENCY=1.0
STREAMING_MAX_DURATION=3600

# === RATE LIMITING (ESTRICTO EN PRODUCCIÓN) ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# === LOGGING ===
LOG_FORMAT=json
LOG_FILE=logs/mcp-core-prod.log
LOG_MAX_SIZE=100
LOG_BACKUP_COUNT=10

# === MONITOREO ===
METRICS_ENABLED=true
TRACING_ENABLED=true

# === AGENTES ===
AGENT_TIMEOUT_SECONDS=300
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_DELAY=2.0

# === EXECUTOR ===
EXECUTOR_MAX_WORKERS=8
EXECUTOR_MEMORY_LIMIT_MB=512
EXECUTOR_CPU_LIMIT=2.0

# === MEMORY MANAGER ===
MEMORY_CACHE_SIZE=2000
MEMORY_CLEANUP_INTERVAL=3600
MEMORY_MAX_AGE_HOURS=24

# === VERIFIER ===
VERIFICATION_QUALITY_THRESHOLD=0.9
VERIFICATION_STRICT_MODE=true

# === HEALTH CHECKS ===
HEALTH_CHECK_INTERVAL=15
HEALTH_CHECK_TIMEOUT=10

# === CORS (RESTRICTIVO EN PRODUCCIÓN) ===
CORS_ENABLED=true
CORS_ORIGINS=${CORS_ORIGINS}
CORS_METHODS=["GET", "POST", "PUT", "DELETE"]
CORS_HEADERS=["Content-Type", "Authorization"]

# === CONFIGURACIONES ESPECÍFICAS DE PRODUCCIÓN ===
AUTO_HEALING_ENABLED=true
INTELLIGENT_ROUTER_ENABLED=true
PARALLEL_EXECUTION_ENABLED=true
COLLABORATION_ENGINE_ENABLED=true
CONTEXT_PERSISTENCE_ENABLED=true
FILE_PROCESSING_ENABLED=true
WEB_SCRAPING_ENABLED=true
GIT_OPERATIONS_ENABLED=true
DATABASE_OPERATIONS_ENABLED=true

# === CONFIGURACIONES DE PRODUCCIÓN ESPECÍFICO ===
SKIP_MIGRATIONS=false
HOT_RELOAD=false
EXPOSE_ALL_ENDPOINTS=false
ENABLE_DEBUG_ENDPOINTS=false
LOAD_TESTING_MODE=false
SECURITY_STRICT_MODE=true
DDOS_PROTECTION_ENABLED=true

# === LIMITS DE RECURSOS ===
EXECUTOR_MEMORY_LIMIT_MB=512
EXECUTOR_CPU_LIMIT=2.0
MAX_CONCURRENT_TASKS=50
MAX_CONCURRENT_TOOLS=10
MEMORY_CACHE_SIZE=2000

# === CONFIGURACIÓN DE SEGURIDAD ===
RATE_LIMIT_STRICT=true
AUTH_REQUIRED=true
SSL_VERIFY=true
SECURITY_HEADERS_ENABLED=true

# === CONFIGURACIÓN DE MONITOREO AVANZADO ===
METRICS_GATHERING_INTERVAL=10
TRACING_SAMPLING_RATE=0.1
ALERTING_ENABLED=true
LOG_ANALYSIS_ENABLED=true

# === CONFIGURACIÓN DE BACKUP ===
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# === CONFIGURACIÓN DE ALTA DISPONIBILIDAD ===
HA_ENABLED=true
HEALTH_CHECK_INTERVAL=15
FAILOVER_TIMEOUT_SECONDS=30
ROLLING_UPDATE_TIMEOUT_SECONDS=600