# MCP Core Superior - Configuración de Staging
# Este archivo contiene configuraciones específicas para el entorno de staging

# === CONFIGURACIÓN BÁSICA ===
ENVIRONMENT=staging
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=MCP Core Superior Staging
APP_VERSION=1.0.0-staging

# === PUERTOS ===
HOST=0.0.0.0
PORT=8080
MCP_PORT=8081
METRICS_PORT=9090

# === CONTEXTFORGE ===
CONTEXTFORGE_URL=http://contextforge:8001
CONTEXTFORGE_TIMEOUT=30
CONTEXTFORGE_API_KEY=

# === BASE DE DATOS ===
DATABASE_URL=postgresql://mcpuser:${POSTGRES_PASSWORD}@postgres:5432/mcp_core
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=15
DATABASE_POOL_TIMEOUT=30

# === VECTOR DATABASE ===
VECTOR_DB_URL=postgresql://mcpuser:${VECTOR_POSTGRES_PASSWORD}@vector_postgres:5432/vector_db
VECTOR_DB_POOL_SIZE=5
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# === REDIS ===
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=30

# === AUTENTICACIÓN ===
JWT_SECRET=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === PERFORMANCE ===
MAX_CONCURRENT_TASKS=15
MAX_CONCURRENT_TOOLS=8
DEFAULT_TIMEOUT_SECONDS=300
STREAMING_BUFFER_SIZE=1000

# === STREAMING ===
STREAMING_ENABLED=true
STREAMING_FREQUENCY=1.0
STREAMING_MAX_DURATION=3600

# === RATE LIMITING (HABILITADO EN STAGING) ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=60

# === LOGGING ===
LOG_FORMAT=json
LOG_FILE=logs/mcp-core-staging.log
LOG_MAX_SIZE=100
LOG_BACKUP_COUNT=5

# === MONITOREO ===
METRICS_ENABLED=true
TRACING_ENABLED=true

# === AGENTES ===
AGENT_TIMEOUT_SECONDS=60
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_DELAY=1.0

# === EXECUTOR ===
EXECUTOR_MAX_WORKERS=3
EXECUTOR_MEMORY_LIMIT_MB=384
EXECUTOR_CPU_LIMIT=1.0

# === MEMORY MANAGER ===
MEMORY_CACHE_SIZE=800
MEMORY_CLEANUP_INTERVAL=3600
MEMORY_MAX_AGE_HOURS=24

# === VERIFIER ===
VERIFICATION_QUALITY_THRESHOLD=0.8
VERIFICATION_STRICT_MODE=false

# === HEALTH CHECKS ===
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# === CORS ===
CORS_ENABLED=true
CORS_ORIGINS=["https://staging.mcp-core-superior.com"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_HEADERS=["Content-Type", "Authorization", "X-Requested-With"]

# === CONFIGURACIONES ESPECÍFICAS DE STAGING ===
AUTO_HEALING_ENABLED=true
INTELLIGENT_ROUTER_ENABLED=true
PARALLEL_EXECUTION_ENABLED=true
COLLABORATION_ENGINE_ENABLED=true
CONTEXT_PERSISTENCE_ENABLED=true
FILE_PROCESSING_ENABLED=true
WEB_SCRAPING_ENABLED=true
GIT_OPERATIONS_ENABLED=true
DATABASE_OPERATIONS_ENABLED=true

# === CONFIGURACIONES DE STAGING ESPECÍFICO ===
SKIP_MIGRATIONS=false
HOT_RELOAD=false
EXPOSE_ALL_ENDPOINTS=false
ENABLE_DEBUG_ENDPOINTS=true
LOAD_TESTING_MODE=false